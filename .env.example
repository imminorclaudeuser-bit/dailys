# Copy to .env (git-ignored) and fill in. `npm start` reads it automatically.
# The site needs no API keys: weather (Open-Meteo) works without one.
ADMIN_EMAIL=you@example.com
PORT=3000
HOST=127.0.0.1
# Behind HTTPS (Caddy/nginx): secure __Host- cookie, HSTS, upgrade-insecure-requests
COOKIE_SECURE=0
# Only when a reverse proxy sets X-Forwarded-For
TRUST_PROXY=0
# Google sign-in (optional). Create an OAuth client ID ("Web application") in Google Cloud Console,
# add this redirect URI to it:  <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://127.0.0.1:3000
